# ---------- Database ----------
DATABASE_URL=postgresql://prospectbot:prospectbot@localhost:5432/prospectbot

# ---------- APIs (leave empty => MOCK mode, works offline) ----------
HUNTER_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# ---------- Lemlist (optional) ----------
LEMLIST_API_KEY=
LEMLIST_CAMPAIGN_PREFIX=ProspectBot

# ---------- Notifications (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Search ----------
SEARCH_KEYWORDS=["startups Node.js", "pymes Python AWS", "tech entrepreneurs Spain"]
SEARCH_COUNTRY=Spain
SEARCH_LIMIT=300

# ---------- Filters ----------
MIN_COMPANY_SIZE=10
MAX_COMPANY_SIZE=500
FOCUS_TECH_STACK=["Node.js", "Python", "AWS", "PostgreSQL"]
# Allowed TLDs for scraped domains
ALLOWED_TLDS=com,es,eu,io

# ---------- Direct email sending (optional) ----------
# Leave SEND_EMAILS=false (default) to dry-run: logs what WOULD be sent, sends nothing.
# Opción recomendada: Resend (gratis, 3000 emails/mes, solo 1 API key, sin config SMTP).
# Crea cuenta en https://resend.com, verifica tu dominio, copia la API key.
RESEND_API_KEY=
# Alternativa: SMTP tradicional (Gmail, etc) — se usa solo si RESEND_API_KEY está vacío.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_FROM_NAME=ProspectBot
EMAIL_REPLY_TO=
EMAIL_SUBJECT=Rápida pregunta sobre {{company}}
EMAIL_UNSUBSCRIBE_TEXT=Si no quieres recibir más correos, responde con "BAJA".
SEND_EMAILS=false
# Max emails sent per pipeline run (keep low to warm up sending reputation)
EMAIL_DAILY_LIMIT=50
# Delay between individual sends (ms) — avoids provider rate limits/spam flags
EMAIL_DELAY_MS=3000
# Optional: AI-personalized opening line per email (Claude API). Leave empty to use the generic line.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------- Detección de respuestas (IMAP, opcional) ----------
# Si se configura, el pipeline revisa la bandeja de entrada cada semana y marca
# qué contactos han respondido (contacts.replied_at). Usa el mismo buzón que EMAIL_FROM.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_SECURE=true

# ---------- Follow-up automático ----------
# Días de espera desde el último contacto antes de mandar un follow-up.
FOLLOW_UP_DELAY_DAYS=4
# Máximo de follow-ups por contacto (no cuenta el email inicial).
FOLLOW_UP_MAX=2

# ---------- Respuesta automática con IA (opcional) ----------
# Con ANTHROPIC_API_KEY configurada, cuando IMAP detecta una respuesta el bot
# redacta un borrador de contestación (guardado en contacts.ai_reply_draft) SIEMPRE.
# Solo lo envía solo si AUTO_REPLY_ENABLED=true — por defecto queda en borrador
# para revisión manual, porque enviar una respuesta de IA sin supervisión es
# irreversible y puede fallar el tono o el contexto.
AUTO_REPLY_ENABLED=false

# ---------- Runtime ----------
# Cron expression (UTC). Default: Monday 09:00
CRON_SCHEDULE=0 9 * * 1
# Run pipeline immediately on start (in addition to cron). true/false
RUN_ON_START=false
# Force mock mode even with keys present. true/false
MOCK_MODE=false
# Delay between HTTP requests (ms)
REQUEST_DELAY_MS=1500
# Max Hunter domain-searches per run (free tier = 100 / month)
HUNTER_MAX_SEARCHES_PER_RUN=25
