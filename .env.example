# ---------- Database ----------
DATABASE_URL=postgresql://prospectbot:prospectbot@localhost:5432/prospectbot

# ---------- APIs (leave empty => MOCK mode, works offline) ----------
HUNTER_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# ---------- Lemlist (optional) ----------
LEMLIST_API_KEY=
LEMLIST_CAMPAIGN_PREFIX=ProspectBot

# ---------- Notifications (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Search ----------
SEARCH_KEYWORDS=["startups Node.js", "pymes Python AWS", "tech entrepreneurs Spain"]
SEARCH_COUNTRY=Spain
SEARCH_LIMIT=300

# ---------- Filters ----------
MIN_COMPANY_SIZE=10
MAX_COMPANY_SIZE=500
FOCUS_TECH_STACK=["Node.js", "Python", "AWS", "PostgreSQL"]
# Allowed TLDs for scraped domains
ALLOWED_TLDS=com,es,eu,io

# ---------- Direct email sending (optional, SMTP) ----------
# Leave SEND_EMAILS=false (default) to dry-run: logs what WOULD be sent, sends nothing.
# Only flip to true after filling SMTP_* + EMAIL_FROM and testing dry-run output.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_FROM_NAME=ProspectBot
EMAIL_REPLY_TO=
EMAIL_SUBJECT=Rápida pregunta sobre {{company}}
EMAIL_UNSUBSCRIBE_TEXT=Si no quieres recibir más correos, responde con "BAJA".
SEND_EMAILS=false
# Max emails sent per pipeline run (keep low to warm up sending reputation)
EMAIL_DAILY_LIMIT=50
# Delay between individual sends (ms) — avoids provider rate limits/spam flags
EMAIL_DELAY_MS=3000

# ---------- Runtime ----------
# Cron expression (UTC). Default: Monday 09:00
CRON_SCHEDULE=0 9 * * 1
# Run pipeline immediately on start (in addition to cron). true/false
RUN_ON_START=false
# Force mock mode even with keys present. true/false
MOCK_MODE=false
# Delay between HTTP requests (ms)
REQUEST_DELAY_MS=1500
# Max Hunter domain-searches per run (free tier = 100 / month)
HUNTER_MAX_SEARCHES_PER_RUN=25
